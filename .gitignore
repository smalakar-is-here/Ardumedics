# ============================================================
# ArduMedics - .gitignore
# ============================================================

# --- Datasets (too large for GitHub) ---
datasets/*
!datasets/.gitkeep
!datasets/README.md
*.zip
*.tar.gz

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Jupyter Notebook ---
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# --- Virtual environments ---
venv/
env/
.venv/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Secrets ---
.env
*.key
ROBOFLOW_API_KEY*

# --- Kaggle ---
kaggle.json

# --- Logs ---
*.log

# --- YOLO runs ---
runs/
wandb/

# --- Ultralytics ---
ultralytics_cache/

# --- OCR cache ---
EasyOCR/
paddleocr/

# --- Large result files ---
results/videos/
results/raw_outputs/

# --- Model weights are tracked by Git LFS ---
# (Don't ignore .pt/.onnx/.ncnn files — they're tracked via .gitattributes)
